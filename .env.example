# Movie Scout — Environment Configuration
#
# This app uses the TVMaze public API (https://api.tvmaze.com) which requires
# NO API key, token, or authentication of any kind. There are no secrets to set.
#
# The only configurable value is the API base URL. It is read at build/run time via
# a Dart compile-time define (see lib/core/config/app_config.dart) and defaults to
# the public TVMaze host, so overriding it is optional (e.g. to point at a mock/proxy):
#
#   flutter run --dart-define=API_BASE_URL=https://api.tvmaze.com

API_BASE_URL=https://api.tvmaze.com
